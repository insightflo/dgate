{
  "name": "dgate",
  "version": "0.1.0",
  "description": "Model-agnostic local SQLite Decision Gate & Multi-Agent Orchestration Engine + TUI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dg": "./src/decision/dg.ts",
    "dgate": "./src/cli.ts"
  },
  "scripts": {
    "start": "node ./src/cli.ts --live",
    "live": "node ./src/cli.ts --live",
    "watch": "node ./src/cli.ts --watch",
    "dgate-tui": "node ./src/cli.ts --watch",
    "demo": "node ./src/cli.ts --demo",
    "stream:sample": "node ./src/cli.ts --file ./examples/sample-session.jsonl",
    "stream:live": "node ./examples/emit-live-stream.ts | node ./src/cli.ts --stream",
    "snapshot": "node ./src/cli.ts --snapshot --time 10 --cols 148 --rows 43",
    "herdr:quad": "node ./scripts/herdr-quad-launch.ts",
    "herdr:quad:live": "node ./scripts/herdr-quad-launch.ts --live",
    "herdr:quad:watch": "node ./scripts/herdr-quad-launch.ts --watch",
    "test": "node --test tests/",
    "setup": "node ./scripts/setup.ts",
    "setup:check": "node ./scripts/setup.ts --check",
    "dg": "node ./src/decision/dg.ts",
    "orchestrate:dry": "node ./scripts/herdr-quad-launch.ts --mode orchestrate --dry-run",
    "rust:build": "cargo build --release",
    "rust:test": "cargo test",
    "gui:build": "cargo build -p dgate-gui",
    "dgate-gui": "cargo run -p dgate-gui --"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
